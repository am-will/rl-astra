# Build the supported libnice ICE backend. The default libjuice binary rejects
# Chrome TCP-TURN checks with a zero-valued ICE tiebreaker.
FROM node:22-bookworm-slim AS rtc-build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake g++ make git pkg-config libssl-dev libnice-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /native
RUN npm install --ignore-scripts --no-audit --no-fund node-datachannel@0.33.2 node-addon-api@8.5.0
RUN ln -s /native/node_modules /native/node_modules/node-datachannel/node_modules && \
    cmake -S node_modules/node-datachannel -B build -DCMAKE_JS_INC=/usr/local/include/node -DUSE_NICE=ON -DNO_MEDIA=ON -DNO_WEBSOCKET=ON -DBUILD_SHARED_LIBS=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_POSITION_INDEPENDENT_CODE=ON && \
    cmake --build build --parallel 2

FROM node:22-bookworm-slim
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends libnice10 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=rtc-build /native/build/node_datachannel.node ./node_modules/node-datachannel/build/Release/node_datachannel.node
COPY dist ./dist
COPY dist-server ./dist-server
RUN mkdir /app/replays && chown node:node /app/replays
USER node
ENV HOST=0.0.0.0 PORT=8787 LOG_DIR=/app/replays MAX_ROOMS=1
CMD ["node", "dist-server/index.mjs"]
